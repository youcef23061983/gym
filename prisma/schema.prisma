generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GalleryImage {
  id        Int      @id @default(autoincrement())
  src       String
  createdAt DateTime @default(now())
}

// model Product {
//   id        Int      @id @default(autoincrement())
//   title     String
//   image     String
//   price     String
//   createdAt DateTime @default(now())
// }
model Product {
  id          Int      @id @default(autoincrement())
  title       String
  image       String
  price       String
  description String? // New field
  category    String? // New field
  stock       Int?     @default(0) // New field
  rating      Float?   @default(0) // New field
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  src         String
  color       String
  createdAt   DateTime @default(now())
}

model Cardio {
  id        Int      @id @default(autoincrement())
  src       String
  createdAt DateTime @default(now())
}

model Exercise {
  id               Int      @id @default(autoincrement())
  bodyPart         String
  equipment        String
  gifUrl           String
  name             String
  target           String
  secondaryMuscles String[]
  instructions     String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([bodyPart])
  @@index([target])
  @@index([equipment])
}
